CREATE TABLE search_history (
    query TEXT NOT NULL,
    kind TEXT NOT NULL,
    searched_at INTEGER NOT NULL,
    PRIMARY KEY (query, kind)
);

CREATE INDEX idx_search_history_searched_at ON search_history(searched_at DESC);

CREATE TABLE play_event (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    song_id TEXT NOT NULL,
    title TEXT NOT NULL,
    subtitle TEXT NOT NULL,
    artwork_url TEXT,
    duration_seconds INTEGER,
    played_seconds INTEGER NOT NULL,
    completion_ratio REAL NOT NULL,
    skipped INTEGER NOT NULL DEFAULT 0,
    played_at INTEGER NOT NULL
);

CREATE INDEX idx_play_event_played_at ON play_event(played_at DESC);
CREATE INDEX idx_play_event_song_id ON play_event(song_id);

CREATE TABLE favorite (
    song_id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    subtitle TEXT NOT NULL,
    artwork_url TEXT,
    duration_seconds INTEGER,
    added_at INTEGER NOT NULL
);

CREATE INDEX idx_favorite_added_at ON favorite(added_at DESC);

upsertSearch:
INSERT OR REPLACE INTO search_history(query, kind, searched_at)
VALUES (:query, :kind, :searchedAt);

recentSearches:
SELECT query, kind, searched_at
FROM search_history
ORDER BY searched_at DESC
LIMIT :limit;

deleteSearch:
DELETE FROM search_history
WHERE query = :query AND kind = :kind;

clearSearches:
DELETE FROM search_history;

trimSearches:
DELETE FROM search_history
WHERE rowid NOT IN (
    SELECT rowid FROM search_history
    ORDER BY searched_at DESC
    LIMIT :keep
);

insertPlayEvent:
INSERT INTO play_event(
    song_id, title, subtitle, artwork_url, duration_seconds,
    played_seconds, completion_ratio, skipped, played_at
) VALUES (
    :songId, :title, :subtitle, :artworkUrl, :durationSeconds,
    :playedSeconds, :completionRatio, :skipped, :playedAt
);

recentPlays:
SELECT id, song_id, title, subtitle, artwork_url, duration_seconds,
       played_seconds, completion_ratio, skipped, played_at
FROM play_event
ORDER BY played_at DESC
LIMIT :limit;

clearPlays:
DELETE FROM play_event;

trimPlays:
DELETE FROM play_event
WHERE id NOT IN (
    SELECT id FROM play_event
    ORDER BY played_at DESC
    LIMIT :keep
);

upsertFavorite:
INSERT OR REPLACE INTO favorite(
    song_id, title, subtitle, artwork_url, duration_seconds, added_at
) VALUES (
    :songId, :title, :subtitle, :artworkUrl, :durationSeconds, :addedAt
);

deleteFavorite:
DELETE FROM favorite
WHERE song_id = :songId;

allFavorites:
SELECT song_id, title, subtitle, artwork_url, duration_seconds, added_at
FROM favorite
ORDER BY added_at DESC;

isFavorite:
SELECT EXISTS(SELECT 1 FROM favorite WHERE song_id = :songId);

clearFavorites:
DELETE FROM favorite;
